# Clerk (required): from the Clerk dashboard, API keys. A development instance is fine locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Backend (Express on 3000; this app runs on 3001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: Trigger.dev API for live streaming. Leave empty for Trigger.dev's cloud, which is what the
# backend uses. No key goes here: the backend hands the browser a short-lived token for each run.
NEXT_PUBLIC_TRIGGER_API_URL=

# Optional: the hosted API reference (the backend's Mintlify docs). The API Keys dialog's "API Reference" opens it;
# left empty, that link is disabled.
NEXT_PUBLIC_DOCS_URL=

# Development only: answer every backend call from in-browser mocks (tests/mocks) instead of the backend.
# Runs are followed by polling in this mode (the mocks can't fake Trigger.dev's live stream). A production
# build ignores this unless ALLOW_MOCKS_IN_BUILD=true is also set when building.
NEXT_PUBLIC_API_MOCKING=false
